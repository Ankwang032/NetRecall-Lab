# 앱은 .env 파일을 자동으로 읽지 않습니다. 환경변수로 export 하거나
# uvicorn --env-file .env 로 실행하세요.

# SQLite DB 위치 (기본: 실행 폴더의 netrecall.db)
NETRECALL_DATABASE_URL=sqlite:///netrecall.db

# Markdown 개념 폴더 (기본: samples/concepts). Obsidian 볼트 경로도 가능
NETRECALL_CONCEPTS_DIR=samples/concepts

# Gemini API 키 (https://aistudio.google.com/apikey). 없으면 AI 질문·평가 API만 503을 돌려줍니다
GEMINI_API_KEY=
# 사용할 Gemini 모델 (기본: gemini-3.6-flash)
NETRECALL_GEMINI_MODEL=

# Notion 통합 토큰 (https://www.notion.so/profile/integrations). 없으면 Notion API만 503을 돌려줍니다.
# 읽을 페이지·데이터베이스의 연결(Connections)에 이 통합을 추가해야 합니다
NOTION_TOKEN=
# 동기화할 Notion "개념" 데이터베이스 주소나 id (docs/notion-concept-source.md). 없으면 Notion 동기화를 건너뜁니다
NETRECALL_NOTION_DATABASE=
